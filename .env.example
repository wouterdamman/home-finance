# Database
DATABASE_URL=postgres://homefinance:homefinance@localhost:5432/homefinance?sslmode=disable

# OIDC
# dex.localhost, not plain localhost: keeps this identical to whatever a
# containerized backend would use (dex.localhost resolves to loopback via
# RFC 6761, same as localhost, but also works as a Docker network alias).
OIDC_ISSUER_URL=http://dex.localhost:5556/dex
OIDC_CLIENT_ID=home-finance
OIDC_CLIENT_SECRET=dev-secret
OIDC_REDIRECT_URL=http://localhost:5173/auth/callback

# Session
SESSION_SECURE=true

# Server
PORT=8080
ENV=development
AUTO_MIGRATE=true

# Dev only
DEV_FAKE_AUTH=false
ALLOWED_EMAILS=

# RBAC: emails in this list get role='admin' the first time they log in
# (upsert only — doesn't override a role changed later via Settings > Users)
INITIAL_ADMIN_EMAILS=

# Static dir (prod: path to built frontend/dist)
STATIC_DIR=

# Object storage (avatars) — S3-compatible, any provider. Leave empty to
# disable avatar upload; everything else in the app works without it.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_USE_SSL=true
